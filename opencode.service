[Unit]
Description=OpenCode AI coding assistant HTTP server
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment="HOME=/home/ubuntu"
ExecStartPre=/bin/bash -c 'mkdir -p /home/ubuntu/.opencode-server/{run,logs}'
ExecStart=/bin/bash -c 'eval "$(/home/ubuntu/.local/bin/mise activate bash)" && exec opencode serve --hostname 0.0.0.0 --port ${OPENCODE_PORT:-4096}'
Restart=on-failure
RestartSec=5s
StandardOutput=append:/home/ubuntu/.opencode-server/logs/opencode.log
StandardError=append:/home/ubuntu/.opencode-server/logs/opencode.log

[Install]
WantedBy=multi-user.target
