#!/bin/bash
### BEGIN INIT INFO
# Provides:          opencode
# Required-Start:    $local_fs $network $remote_fs
# Required-Stop:     $local_fs $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: opencode serve
# Description:       OpenCode AI coding assistant HTTP server
### END INIT INFO

NAME="opencode"
DAEMON_USER="ubuntu"
DAEMON_HOME="/home/${DAEMON_USER}"
MISE_BIN="${DAEMON_HOME}/.local/bin/mise"
PIDFILE="/var/run/${NAME}/${NAME}.pid"
LOGFILE="/var/log/${NAME}.log"
OPENCODE_PORT="${OPENCODE_PORT:-4096}"

do_start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME is already running (PID: $(cat "$PIDFILE"))"
        return 0
    fi

    mkdir -p /var/run/${NAME}
    chown "${DAEMON_USER}:${DAEMON_USER}" /var/run/${NAME}
    touch "$LOGFILE"
    chown "${DAEMON_USER}:${DAEMON_USER}" "$LOGFILE"

    echo "Starting $NAME..."
    start-stop-daemon --start --quiet --background \
        --make-pidfile --pidfile "$PIDFILE" \
        --chuid "$DAEMON_USER" \
        --startas /bin/bash -- -c "
            export HOME=${DAEMON_HOME}
            eval \"\$(${MISE_BIN} activate bash)\" >> ${LOGFILE} 2>&1
            exec opencode serve --hostname 0.0.0.0 --port ${OPENCODE_PORT} >> ${LOGFILE} 2>&1
        "

    # 验证进程确实启动
    sleep 1
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME started (PID: $(cat "$PIDFILE"))"
    else
        echo "$NAME failed to start, check $LOGFILE" >&2
        rm -f "$PIDFILE"
        return 1
    fi
}

do_stop() {
    if [ ! -f "$PIDFILE" ] || ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME is not running"
        rm -f "$PIDFILE"
        return 0
    fi

    echo "Stopping $NAME..."
    if start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --retry=TERM/5/KILL/3; then
        rm -f "$PIDFILE"
        echo "$NAME stopped"
    else
        echo "$NAME failed to stop cleanly, forcing cleanup" >&2
        rm -f "$PIDFILE"
        return 1
    fi
}

do_status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME is running (PID: $(cat "$PIDFILE"))"
    else
        echo "$NAME is not running"
        rm -f "$PIDFILE"
        exit 3
    fi
}

case "$1" in
    start)   do_start ;;
    stop)    do_stop ;;
    restart) do_stop; do_start ;;
    status)  do_status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
